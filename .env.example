# URL pública usada pela aplicação.
APP_URL=http://localhost:3000

# Conexão com PostgreSQL.
DATABASE_URL=postgresql://appyflow:appyflow@localhost:5432/appyflow

# Providers permanecem desabilitados até que uma integração seja configurada.
# As chaves são lidas somente no servidor. Nunca use variáveis NEXT_PUBLIC_*.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
SEARCH_PROVIDER=disabled
SEARCH_API_KEY=
