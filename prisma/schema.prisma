generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  installationKey  String            @default("primary") @map("installation_key") @db.VarChar(32)
  email            String            @unique @db.VarChar(320)
  displayName      String?           @map("display_name") @db.VarChar(120)
  passwordHash     String            @map("password_hash") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions         Session[]
  resumes          Resume[]
  candidateProfile CandidateProfile?

  @@unique([installationKey], map: "users_installation_key_key")
  @@map("users")
}

model Resume {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  originalName  String             @map("original_name") @db.VarChar(255)
  mediaType     String             @map("media_type") @db.VarChar(100)
  sizeBytes     Int                @map("size_bytes")
  checksum      String             @db.Char(64)
  storageKey    String             @unique @map("storage_key") @db.VarChar(255)
  extractedText String             @map("extracted_text") @db.Text
  pageCount     Int                @map("page_count")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  facts         ProfessionalFact[]

  @@index([userId, createdAt])
  @@map("resumes")
}

enum Seniority {
  UNSPECIFIED
  INTERN
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  MANAGER
  EXECUTIVE
}

enum ProfessionalFactType {
  SKILL
  EXPERIENCE
}

enum FactReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum SearchQueryOrigin {
  DETERMINISTIC
  AI
}

model CandidateProfile {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  headline          String?            @db.VarChar(160)
  summary           String?            @db.Text
  seniority         Seniority          @default(UNSPECIFIED)
  city              String?            @db.VarChar(120)
  region            String?            @db.VarChar(120)
  country           String?            @db.VarChar(2)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalFacts ProfessionalFact[]
  preference        Preference?
  searchQueries     SearchQuery[]

  @@map("candidate_profiles")
}

model SearchQuery {
  id          String            @id @default(uuid()) @db.Uuid
  profileId   String            @map("profile_id") @db.Uuid
  query       String            @db.VarChar(300)
  normalized  String            @db.VarChar(300)
  origin      SearchQueryOrigin
  aiModel     String?           @map("ai_model") @db.VarChar(160)
  aiRequestId String?           @map("ai_request_id") @db.VarChar(255)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  profile     CandidateProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, normalized])
  @@index([profileId, createdAt])
  @@map("search_queries")
}

model Preference {
  id                String           @id @default(uuid()) @db.Uuid
  profileId         String           @unique @map("profile_id") @db.Uuid
  desiredRoles      String[]         @default([]) @map("desired_roles")
  seniorities       Seniority[]      @default([])
  workModes         WorkMode[]       @default([]) @map("work_modes")
  locations         String[]         @default([])
  languages         String[]         @default([])
  technologies      String[]         @default([])
  salaryMinimum     Decimal?         @map("salary_minimum") @db.Decimal(12, 2)
  salaryCurrency    String?          @map("salary_currency") @db.Char(3)
  excludedCompanies String[]         @default([]) @map("excluded_companies")
  excludedKeywords  String[]         @default([]) @map("excluded_keywords")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile           CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model ProfessionalFact {
  id             String               @id @default(uuid()) @db.Uuid
  profileId      String               @map("profile_id") @db.Uuid
  type           ProfessionalFactType
  title          String               @db.VarChar(160)
  organization   String?              @db.VarChar(160)
  description    String?              @db.Text
  startedAt      DateTime?            @map("started_at") @db.Date
  endedAt        DateTime?            @map("ended_at") @db.Date
  sourceResumeId String?              @map("source_resume_id") @db.Uuid
  reviewStatus   FactReviewStatus     @default(CONFIRMED) @map("review_status")
  evidenceQuote  String?              @map("evidence_quote") @db.Text
  aiModel        String?              @map("ai_model") @db.VarChar(160)
  aiRequestId    String?              @map("ai_request_id") @db.VarChar(255)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile        CandidateProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceResume   Resume?              @relation(fields: [sourceResumeId], references: [id], onDelete: Cascade)

  @@index([profileId, type])
  @@index([sourceResumeId])
  @@map("professional_facts")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
